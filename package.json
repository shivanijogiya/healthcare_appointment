{
  "name": "healthcare-appointment-manager",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/types",
    "packages/db",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build:packages": "npm run build -w @ham/types && npm run build -w @ham/db",
    "prepare": "npm run build:packages",
    "build": "npm run build:packages && npm run build -w @ham/api && npm run build -w @ham/web",
    "migrate": "npm run migrate -w @ham/db",
    "seed": "npm run seed -w @ham/db",
    "db:reset": "npm run reset -w @ham/db",
    "start:api": "npm run start:prod -w @ham/api",
    "start:worker": "npm run start:worker -w @ham/api",
    "dev:api": "npm run dev -w @ham/api",
    "dev:worker": "npm run dev:worker -w @ham/api",
    "dev:web": "npm run dev -w @ham/web",
    "predev": "npm run build:packages",
    "dev": "concurrently -n api,worker,web -c cyan,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "pretest": "npm run build:packages",
    "test": "npm run test -w @ham/api",
    "test:unit": "npm run test -w @ham/api",
    "test:e2e": "node tests/e2e-smoke.mjs",
    "test:leave": "node tests/leave.mjs",
    "test:concurrency": "node tests/concurrency.mjs 50",
    "test:failure": "node tests/failure-injection.mjs",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:leave && npm run test:concurrency"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
