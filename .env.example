# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173          # CORS origin(s), comma-separated
API_URL=http://localhost:3000

# The clinic runs on a fixed UTC offset. 330 = IST (Asia/Kolkata).
# Availability is stored as wall-clock time ("09:00"); this converts it.
CLINIC_TIMEZONE_OFFSET_MINUTES=330

# ─── Data stores ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ham:ham@localhost:5432/ham
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 32 bytes of hex. Encrypts Google refresh tokens at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── LLM ──────────────────────────────────────────────────────────────────
# mock    — deterministic offline stub; the default, needs no API key
# failing — always throws; used to prove graceful degradation
# anthropic | openai — real providers, require LLM_API_KEY
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=
LLM_TIMEOUT_MS=15000
LLM_MAX_ATTEMPTS=3
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_MS=60000

# ─── Email ────────────────────────────────────────────────────────────────
# file    — writes .html files to MAIL_OUTPUT_DIR; the default, needs no SMTP
# smtp    — real delivery via SendGrid, Mailgun, Gmail, anything with SMTP
# failing — always throws; used to prove the retry ladder and DEAD state
MAIL_TRANSPORT=file
MAIL_OUTPUT_DIR=./var/mail
MAIL_FROM="Meridian Clinic <noreply@clinic.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Google Calendar (optional) ───────────────────────────────────────────
# Leave blank to run without calendar integration; every calendar step then
# becomes a silent no-op. See docs/google-calendar-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar/callback

# ─── Scheduling ───────────────────────────────────────────────────────────
SLOT_HOLD_TTL_MINUTES=10
REMINDER_HOURS_BEFORE=24
MAX_ADVANCE_BOOKING_DAYS=60
MEDICATION_REMINDER_MAX_DAYS=90
